{
  "name": "vue-relative-rotation-chart",
  "version": "0.1.3",
  "description": "Vue 3 SVG renderer for RRG-style stock, ETF, sector, index, and portfolio rotation charts with animated tails, playback controls, and PNG export.",
  "license": "MIT",
  "homepage": "https://rabeehanna.github.io/vue-relative-rotation-chart/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RabeeHanna/vue-relative-rotation-chart.git"
  },
  "bugs": {
    "url": "https://github.com/RabeeHanna/vue-relative-rotation-chart/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "svg",
    "chart",
    "data-visualization",
    "financial-chart",
    "stock-chart",
    "stock-dashboard",
    "sector-rotation",
    "market-rotation",
    "relative-rotation-graph",
    "rrg",
    "rrg-chart",
    "relative-strength",
    "relative-momentum",
    "rs-ratio",
    "rs-momentum",
    "quadrant-chart",
    "animated-chart",
    "timeline-playback",
    "portfolio-visualization"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-relative-rotation-chart.umd.cjs",
  "module": "./dist/vue-relative-rotation-chart.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-relative-rotation-chart.js",
      "require": "./dist/vue-relative-rotation-chart.umd.cjs"
    },
    "./style.css": "./dist/vue-relative-rotation-chart.css",
    "./scenarios": {
      "types": "./dist/scenarios/index.d.ts",
      "import": "./dist/scenarios.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.build.json --noEmit && vite build && vite build --config vite.scenarios.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:agent-guide": "playwright test tests/e2e/agent-guide.spec.ts",
    "test:perf": "playwright test --config=playwright.perf.config.ts",
    "check:bundle-size": "vitest run tests/perf/bundleSize.test.ts",
    "review:artifacts": "playwright test --config=playwright.review.config.ts",
    "review:screenshots": "npm run review:artifacts",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "spike:labels": "vitest run spikes/label-collision"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.62.0",
    "@types/d3-array": "^3.2.1",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^22.15.32",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.30.1",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.10"
  }
}
